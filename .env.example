# Polymarket Widget — environment (all optional; the demo runs with none set)

# Base URL for Polymarket Gamma reads (public, no auth, CORS *).
# Default when unset:
#   VITE_GAMMA_BASE_URL=https://gamma-api.polymarket.com
# CORS contingency: point at the built-in Vite dev proxy instead (NFR-SVC-2):
#   VITE_GAMMA_BASE_URL=/gamma-api

# No API keys or secrets are required for the real read path (NFR-SEC-3).
# The OpenRouter AI key is user-supplied at runtime in Settings, never bundled.
