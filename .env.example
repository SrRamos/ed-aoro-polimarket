# Polymarket Widget — environment configuration
# Copy to `.env.local` and adjust. ALL values here are PUBLIC (VITE_* is inlined
# into the client bundle) — NEVER put a secret/API key in a VITE_* var (NFR-SEC-1).
# The OpenRouter key is entered at runtime in Settings and stored in localStorage,
# it is never read from the environment.

# Polymarket Gamma REST base URL. Must be https:// (config rejects http://).
VITE_GAMMA_BASE_URL=https://gamma-api.polymarket.com

# OpenRouter API base URL. Must be https://.
VITE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Betting execution mode.
#   mock  — simulated betting (default; the only mode that ships in Phase 1)
#   real  — on-chain CLOB betting (Phase 2; fails safe to a disabled state until an adapter exists)
VITE_BET_MODE=mock

# AI request path.
#   user-key — browser calls OpenRouter directly with the user's key (default)
#   proxy    — server-side AI proxy (Phase 2; not yet implemented)
VITE_AI_MODE=user-key
